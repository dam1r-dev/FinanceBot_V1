# Telegram
BOT_TOKEN=                     # токен от @BotFather
TELEGRAM_WEBHOOK_SECRET=       # случайная строка, для валидации входящих webhook-запросов от Telegram

# Database (Neon Postgres в проде, любой Postgres локально)
DATABASE_URL=                  # postgres://user:password@host:5432/dbname?sslmode=require

# Mini App
MINI_APP_URL=                  # публичный HTTPS-адрес деплоя, напр. https://financebot.vercel.app

# Cron
CRON_SECRET=                   # случайная строка, для защиты /api/cron/* от вызовов извне Vercel

# OCR чеков (заглушка, см. packages/bot/src/services/ocr.ts)
OCR_PROVIDER=                  # google-vision | claude-vision (пока не реализовано)
OCR_API_KEY=

# Курсы валют (open.er-api.com — бесплатный, без ключа)
FX_API_URL=https://open.er-api.com/v6
